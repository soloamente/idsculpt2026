{
	"name": "idsculpt26",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/node": "^26.4.1",
			"varlock": "1.23.0",
			"lucide-react": "^1.41.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"@trpc/server": "^11.19.0",
			"@trpc/client": "^11.19.0",
			"better-auth": "1.7.12",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7",
			"tailwindcss": "^4.3.3",
			"drizzle-orm": "1.0.0-rc.5"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"db:push": "turbo run db:push -F @idsculpt26/db --",
		"db:studio": "turbo run db:studio -F @idsculpt26/db --",
		"db:generate": "turbo run db:generate -F @idsculpt26/db --",
		"db:migrate": "turbo run db:migrate -F @idsculpt26/db --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/web && bun run auth:generate",
		"check": "biome check --write ."
	},
	"dependencies": {
		"skullet": "^0.0.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@idsculpt26/config": "workspace:*",
		"@types/node": "catalog:",
		"agentation": "^3.1.2",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"overrides": {
		"@next/env": "npm:@varlock/nextjs-integration@1.2.2"
	},
	"packageManager": "bun@1.3.4"
}
