# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Auth and the database are only used by login and the dashboard.
# The public site must build when they are unset (Vercel); those routes throw on use until they are set.
# @optional
# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @optional
# @type=url
BETTER_AUTH_URL=

# @optional
# @type=string(minLength=1)
DATABASE_URL=
